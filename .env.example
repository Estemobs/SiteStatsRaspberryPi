# Copiez ce fichier en .env et renseignez vos propres valeurs.
# .env ne doit jamais être commité (voir .gitignore).

# Chemin du fichier SQLite utilisé par le serveur et par mesure_valeur.py (local)
DB_PATH=data.db

# Adresse et port d'écoute du serveur FastAPI
API_HOST=0.0.0.0
API_PORT=2006

# Jeton partagé pour authentifier les envois de mesure_valeur_vps.py vers l'API
# Générez-en un avec: python -c "import secrets; print(secrets.token_hex(32))"
API_TOKEN=

# URL complète de l'endpoint d'ingestion, utilisée par mesure_valeur_vps.py
# depuis un serveur distant (remplacez par l'adresse publique du serveur FastAPI)
API_URL=http://localhost:2006/api/measurements

# Hôte pingué pour mesurer la latence
PING_TARGET=google.com
